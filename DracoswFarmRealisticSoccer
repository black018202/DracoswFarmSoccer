-- IR PARA A COORDENADA APÓS DEFENDER (parte do Auto Dive Farm)
-- A cada defesa (placar de salvamentos +1) o personagem faz UM tween linear
-- até WALK_POS na velocidade WALK_SPEED. Sem loop: depois que chega, nada
-- fica reforçando a posição. Na próxima defesa, faz o tween de novo.
local TweenService = game:GetService("TweenService")

local WALK_POS = Vector3.new(156.1, 6.1, 10.8)
local WALK_SPEED = 28        -- velocidade do tween de volta ao lugar salvo (studs por segundo): maior = mais rápido
local WALK_KEEP_Y = false    -- false = usa o Y exato da coordenada; true = mantém a altura atual

local walkTween

local function stopWalkTween()
    if walkTween then
        walkTween:Cancel()
        walkTween = nil
    end
end

localPlayer.CharacterAdded:Connect(function()
    walkToPoint = false
    stopWalkTween()
end)

task.spawn(function()
    while true do
        if not autoDive then
            walkToPoint = false
            stopWalkTween()
        elseif walkToPoint and not chasingPlayer then
            walkToPoint = false -- consome o pedido: um único tween por defesa

            local char = localPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 then
                stopWalkTween()

                local target = Vector3.new(
                    WALK_POS.X,
                    WALK_KEEP_Y and hrp.Position.Y or WALK_POS.Y,
                    WALK_POS.Z
                )
                local dist = (target - hrp.Position).Magnitude

                if dist > 0.5 then
                    local rotation = hrp.CFrame - hrp.CFrame.Position
                    walkTween = TweenService:Create(
                        hrp,
                        TweenInfo.new(dist / WALK_SPEED, Enum.EasingStyle.Linear),
                        { CFrame = CFrame.new(target) * rotation }
                    )
                    walkTween:Play()
                end
            end
        end

        task.wait(0.05)
    end
end)

-- ADICIONAL (fora do script original do Auto Dive): volta ao lugar salvo após Q ou E
local lastReturnRequest = 0
local returnToken = 0

local function requestReturnTween()
    lastDiveClock = os.clock()
    -- Se um tween ainda está te levando ao lugar salvo, cancela na hora para ele
    -- não arrastar o personagem durante o pulo/defesa.
    stopWalkTween()

    local now = os.clock()
    if now - lastReturnRequest < 0.3 then return end -- evita pedidos duplicados
    lastReturnRequest = now

    -- Só o pulo mais recente conta: pedidos antigos não iniciam o tween no meio de outro pulo
    returnToken += 1
    local myToken = returnToken
    task.delay(DIVE_RETURN_DELAY, function()
        if autoDive and myToken == returnToken then
            walkToPoint = true
        end
    end)
end

-- Quando o Auto Dive aperta Q ou E, avisa o tween. O sendKey ORIGINAL (acima) não foi
-- alterado: ele roda primeiro, exatamente como era, e só depois o aviso é feito.
do
    local originalSendKey = sendKey
    sendKey = function(key)
        originalSendKey(key)
        if (key == Enum.KeyCode.Q or key == Enum.KeyCode.E) and autoDive then
            requestReturnTween()
        end
    end
end

-- AUTO DIVE + STAMINA (copiado do script original do Auto Dive, sem alterações)
-- MELHORIA DO AUTO DIVE: pega a bola olhando a TRAJETÓRIA (onde ela cruza a linha do goleiro).
-- S = 0: checa a cada frame (antes esperava 0.03s entre as checagens)
local DIVE_RANGE = 34            -- alcance pra bola vindo de frente (antes 22): enxerga chute forte de mais longe
local DIVE_FRONT = -32           -- até onde na frente (Z) já enxerga a bola vindo (antes -19)
local DIVE_TRIGGER_TIME = 0.30   -- pula quando a bola chega em até X s (base)...
local DIVE_LATERAL_TIME = 0.012  -- ...mais X s por stud de distância lateral (bola longe do goleiro = pula antes)
local DIVE_MAX_LATERAL = 20      -- limite da distância lateral usada nessa conta
local DIVE_URGENT_TIME = 0.15    -- bola chegando em menos que isso: pula na hora, sem confirmar
local DIVE_CONFIRM_FRAMES = 2    -- senão precisa dar o MESMO lado em X checagens seguidas
local DIVE_CONFIRM_WINDOW = 0.1  -- as checagens precisam ser seguidas (em segundos)
local DIVE_MAX_BALL_HEIGHT = 3.5 -- bola mais alta que isso acima do seu HumanoidRootPart = por cima da cabeça, não pula
local FAST_BALL = 35             -- acima disso a bola é chute/passe: perto de jogador não conta como "bola presa"
local R, S = 0, 0

local pendingKey, pendingCount, pendingTime = nil, 0, 0
local lastBallObj, lastBallPos, lastBallTime = nil, nil, 0

-- COMPENSAÇÃO DE PING: a bola que você vê está atrasada em relação ao servidor,
-- então com ping alto o pulo precisa sair um pouco mais cedo.
local Stats = game:GetService("Stats")
local DIVE_PING_COMP = 0.5   -- fração do ping somada à antecedência do pulo (0 = desliga)
local pingSeconds = 0

task.spawn(function()
    while true do
        local ok, ms = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(ms) == "number" then
            pingSeconds = math.clamp(ms / 1000, 0, 0.4)
        end
        task.wait(0.5)
    end
end)

-- Bola presa (solda/personagem): vale mesmo com a bola rápida
local function isBallAttached(I)
    if I:FindFirstChildOfClass("Weld") or I:FindFirstChildOfClass("WeldConstraint") or I:FindFirstChildOfClass("Motor6D") then return true end
    local J = I.Parent if J and J:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

-- Decide o lado do pulo. Retorna (tecla, urgente) ou nil
local function diveKeyFor(a1, ballPos, ballVel)
    local a7 = a1.CFrame:PointToObjectSpace(ballPos)
    local dist = (ballPos - a1.Position).Magnitude

    -- velocidade da bola em relação ao goleiro (Z > 0 = bola vindo na direção dele)
    local lv = a1.CFrame:VectorToObjectSpace(ballVel)

    if a7.Z < 0 and lv.Z > 3 then
        -- TRAJETÓRIA: bola vindo de frente
        if dist > DIVE_RANGE or a7.Z < DIVE_FRONT then return nil end
        local tReach = -a7.Z / lv.Z                         -- tempo até a bola chegar na linha do goleiro
        local crossX = a7.X + lv.X * tReach                 -- onde ela vai cruzar (esquerda/direita)
        local need = DIVE_TRIGGER_TIME + math.min(math.abs(crossX), DIVE_MAX_LATERAL) * DIVE_LATERAL_TIME
                   + pingSeconds * DIVE_PING_COMP
        if tReach > need then return nil end                -- ainda cedo: espera pra não errar o lado

        -- altura prevista da bola quando chegar na sua linha (com gravidade)
        local predictedY = ballPos.Y + ballVel.Y * tReach - 0.5 * Workspace.Gravity * tReach * tReach
        if predictedY - a1.Position.Y > DIVE_MAX_BALL_HEIGHT then return nil end -- vai passar por cima da cabeça

        local urgent = tReach <= DIVE_URGENT_TIME + pingSeconds * DIVE_PING_COMP
        if crossX > 1.5 then return Enum.KeyCode.E, urgent
        elseif crossX < -1.5 then return Enum.KeyCode.Q, urgent end
        return nil                                          -- vai no meio, direto no goleiro
    end

    -- bola não vem de frente: regra original (lado pela posição atual)
    if ballPos.Y - a1.Position.Y > DIVE_MAX_BALL_HEIGHT then return nil end -- bola já está acima da cabeça
    if dist > q or a7.Z < t or a7.Z > u then return nil end
    if a7.X > 1.5 then return Enum.KeyCode.E, false elseif a7.X < -1.5 then return Enum.KeyCode.Q, false end
    return nil
end

RunService.Heartbeat:Connect(function(T)
    local U = localPlayer.Character if not U then return end

    -- Executa o boost de velocidade/stamina se ativado
    if infStamina then
        local targetSpd = speedValue
        local V = U:FindFirstChildOfClass("Humanoid")
        local W = U:FindFirstChild("HumanoidRootPart")
        if W and V and V.Health > 0 then
            local X = V.MoveDirection 
            if X.Magnitude == 0 then 
                local Y = Vector3.new(W.AssemblyLinearVelocity.X, 0, W.AssemblyLinearVelocity.Z)
                if Y.Magnitude > 1 then X = Y.Unit end 
            end
            if X.Magnitude > 0 then 
                local Z = targetSpd - z 
                local _ = Vector3.new(X.X, 0, X.Z).Unit * (Z * T)
                W.CFrame = W.CFrame + _ 
            end
        end
    end

    if not autoDive then return end

    local a0 = os.clock() if (a0 - R) < S then return end R = a0
    local a1 = U:FindFirstChild("HumanoidRootPart")
    local a2 = U:FindFirstChildOfClass("Humanoid") 
    if not a1 or not a2 then return end
    if (a0 - v) < r then return end
    local a3 = D() if not a3 then return end
    
    local velBola = a3.AssemblyLinearVelocity or a3.Velocity

    -- Se a velocidade informada vier zerada/baixa demais, usa o deslocamento real da bola entre frames
    local nowPos = a3.Position
    if lastBallObj == a3 and (a0 - lastBallTime) > 0 and (a0 - lastBallTime) < 0.1 then
        local posVel = (nowPos - lastBallPos) / (a0 - lastBallTime)
        local posH = Vector3.new(posVel.X, 0, posVel.Z).Magnitude
        local repH = Vector3.new(velBola.X, 0, velBola.Z).Magnitude
        if posH > 8 and posH < 300 and posH > repH * 1.5 then velBola = posVel end
    end
    lastBallObj, lastBallPos, lastBallTime = a3, nowPos, a0

    -- Ignora se a bola estiver devagar ou parada (velocidade horizontal abaixo de 2.5)
    local velHorizontal = Vector3.new(velBola.X, 0, velBola.Z).Magnitude
    if velHorizontal <= 2.5 then return end

    -- Bola presa: devagar usa a checagem completa (H); chute/passe rápido só olha se está presa de verdade,
    -- assim um jogador perto da bola não bloqueia o pulo
    if velHorizontal < FAST_BALL then
        if H(a3) then return end
    elseif isBallAttached(a3) then
        return
    end

    local diveKey, urgent = diveKeyFor(a1, a3.Position, velBola)
    if diveKey then
        -- confirma o lado em checagens seguidas antes de pular (bola chegando já = pula na hora)
        if diveKey == pendingKey and (a0 - pendingTime) <= DIVE_CONFIRM_WINDOW then
            pendingCount += 1
        else
            pendingKey, pendingCount = diveKey, 1
        end
        pendingTime = a0

        if urgent or pendingCount >= DIVE_CONFIRM_FRAMES then
            pendingKey, pendingCount = nil, 0
            v = a0 sendKey(diveKey)
        end
    else
        pendingKey, pendingCount = nil, 0
    end
end)

