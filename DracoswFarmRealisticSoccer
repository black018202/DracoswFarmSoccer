local function findSavesStat()
    local ls = localPlayer:FindFirstChild("leaderstats")
    if not ls then return nil end

    if SAVES_STAT_NAME then
        local stat = ls:FindFirstChild(SAVES_STAT_NAME)
        if stat and stat:IsA("ValueBase") then return stat end
        return nil
    end

    for _, child in ipairs(ls:GetChildren()) do
        if child:IsA("ValueBase") then
            local n = child.Name:lower()
            if n:find("save") or n:find("salv") or n:find("defes") then
                return child
            end
        end
    end
    return nil
end

-- Espera o placar carregar e passa a acompanhar cada aumento de defesas
task.spawn(function()
    local stat
    while not stat do
        stat = findSavesStat()
        if not stat then task.wait(1) end
    end

    lastValue = tonumber(stat.Value) or 0
    totalSaves = lastValue
    updateSavesUI()

    stat:GetPropertyChangedSignal("Value"):Connect(function()
        local newValue = tonumber(stat.Value) or 0
        if newValue > lastValue then
            sessionSaves += (newValue - lastValue)
            -- Defendeu: com Auto Dive Farm ligado, faz um tween até a coordenada
            if autoDive then
                walkToPoint = true
            end
        end
        lastValue = newValue
        totalSaves = newValue
        updateSavesUI()
    end)
end)

-- ZONA 45x45 INVISÍVEL (parte do Auto Dive Farm): com ele ligado, ao entrar
-- nela vira Goleiro automaticamente (repete até conseguir)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ZONE_POS = Vector3.new(0, -90, 45)   -- coordenada copiada
local ZONE_SIZE = 45                       -- área de 45 x 45
local ZONE_RETRY = 0.5                     -- segundos entre cada tentativa
local GOALIE_COLOR = BrickColor.new("Earth green")

local function isInsideZone(pos)
    local half = ZONE_SIZE / 2
    return math.abs(pos.X - ZONE_POS.X) <= half
        and math.abs(pos.Y - ZONE_POS.Y) <= half
        and math.abs(pos.Z - ZONE_POS.Z) <= half
end

local function fireGoalie()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local event = remotes and remotes:FindFirstChild("TeamChange")
    if event then
        pcall(function()
            event:FireServer(GOALIE_COLOR, "Goalie")
        end)
    end
end

