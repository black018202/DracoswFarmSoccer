    if not autoDive then return end

    local a0 = os.clock() if (a0 - R) < S then return end R = a0
    local a1 = U:FindFirstChild("HumanoidRootPart")
    local a2 = U:FindFirstChildOfClass("Humanoid") 
    if not a1 or not a2 then return end
    if (a0 - v) < r then return end
    local a3 = D() if not a3 or H(a3) then return end
    
    -- Ignora se a bola estiver devagar ou parada (velocidade horizontal abaixo de 2.5)
    local velBola = a3.AssemblyLinearVelocity or a3.Velocity
    local velHorizontal = Vector3.new(velBola.X, 0, velBola.Z).Magnitude
    if velHorizontal <= 2.5 then return end

    local a4 = a3.Position local a5 = a1.Position local a6 = (a4 - a5).Magnitude
    if a6 <= q then
        local a7 = a1.CFrame:PointToObjectSpace(a4)
        if a7.Z >= t and a7.Z <= u then
            if a7.X > 1.5 then v = a0 sendKey(Enum.KeyCode.E) elseif a7.X < -1.5 then v = a0 sendKey(Enum.KeyCode.Q) end
        end
    end
end)

-- Teclas Q e E (você apertando): com Auto Dive Farm ligado, também volta ao lugar salvo
UserInputService.InputBegan:Connect(function(input)
    if (input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.E)
        and autoDive
        and not UserInputService:GetFocusedTextBox() then
