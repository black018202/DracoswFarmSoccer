-- OLHAR SEMPRE PRA FRENTE (parte do Auto Dive Farm)
-- Com o Auto Dive Farm ligado, o personagem fica travado olhando numa direção fixa,
-- instantaneamente (a cada frame). Não altera o Auto Dive nem o tween.
-- Quando chega no gol (WALK_POS), a direção é capturada UMA vez de novo e travada.
local GOAL_ARRIVE_DIST = 4 -- distância até o gol para considerar "chegou"

local lockedLook = nil
local faceWasActive = false
local goalFaceDone = false

-- Ao renascer, captura a direção de novo
localPlayer.CharacterAdded:Connect(function()
    faceWasActive = false
    goalFaceDone = false
    lockedLook = nil
end)

local function captureLook(hrp)
    local dir = FACE_DIRECTION or hrp.CFrame.LookVector
    dir = Vector3.new(dir.X, 0, dir.Z)
    return dir.Magnitude > 0 and dir.Unit or Vector3.new(0, 0, -1)
end

RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return end

    if autoDive then
        -- Durante o mergulho (Q/E) não mexe na rotação: o Auto Dive roda igual ao original
        if os.clock() - lastDiveClock < DIVE_FREE_TIME then
            hum.AutoRotate = true
            return
        end

        if not faceWasActive then
            faceWasActive = true
            lockedLook = captureLook(hrp)
        end

        -- Chegou no gol: ativa o olhar pra frente uma vez (recaptura a direção)
        if not goalFaceDone and (hrp.Position - WALK_POS).Magnitude <= GOAL_ARRIVE_DIST then
            goalFaceDone = true
            lockedLook = captureLook(hrp)
        end

        hum.AutoRotate = false -- impede o Humanoid de girar o personagem pro lado que anda

        local pos = hrp.Position
        hrp.CFrame = CFrame.lookAt(pos, pos + lockedLook)
        hrp.AssemblyAngularVelocity = Vector3.zero
    elseif faceWasActive then
        faceWasActive = false
        goalFaceDone = false
        lockedLook = nil
        hum.AutoRotate = true -- desligou: volta ao normal
    end
end)

-- ÁREA VERMELHA NO CHÃO (parte do Auto Dive Farm)
-- Com o Auto Dive Farm ligado aparece uma área vermelha no chão, perto do gol.
-- Quando a BOLA (a mesma que o Auto Dive enxerga) entra nela, seu personagem faz um
-- tween até a bola e depois volta pra coordenada salva (WALK_POS).
local RED_ZONE_SIZE_X = 3                                            -- parte da área ATRÁS dos pés do personagem (em studs)
local RED_ZONE_FRONT_EXTRA = 14                                       -- AUMENTO PRA FRENTE: quanto a área vai pra frente dos pés (em studs)
local RED_ZONE_SIZE_Z = 28                                            -- lados da área (em studs)
local RED_ZONE_LOWER = 0.8                                            -- quanto a área desce em relação ao chão estimado (studs)
local RED_ZONE_SELF_MARGIN = 40                                        -- folga só pra checar se VOCÊ está na área
local RED_ZONE_LENGTH_X = RED_ZONE_SIZE_X + RED_ZONE_FRONT_EXTRA      -- comprimento total (atrás + frente)
-- "Frente" = direção do FACE_DIRECTION (eixo X). Nos pés do personagem no local salvo (WALK_POS)
-- a área tem RED_ZONE_SIZE_X pra trás e RED_ZONE_FRONT_EXTRA pra frente.
local frontSign = (FACE_DIRECTION and FACE_DIRECTION.X > 0) and 1 or -1
local RED_ZONE_POS = Vector3.new(
    WALK_POS.X + frontSign * (RED_ZONE_FRONT_EXTRA - RED_ZONE_SIZE_X) / 2,
    WALK_POS.Y - 3 - RED_ZONE_LOWER,
    WALK_POS.Z
) -- centro (altura do chão)
local CHASE_TWEEN_SPEED = 80   -- velocidade do tween até a bola (studs/s): maior = mais rápido
local CHASE_STOP_DIST = 2.5    -- para a X studs da bola (não entra dentro dela)
local CHASE_LEAD = 0.1         -- mira pra onde a bola vai estar daqui a X segundos
local CHASE_EXIT_GRACE = 0.4   -- segundos que ainda vai atrás dela mesmo se a bola já saiu da área
local CHASE_MAX_FROM_POST = 50 -- não se afasta mais que isso do lugar salvo (WALK_POS)
local CHASE_TIMEOUT = 2        -- desiste se não alcançar em X segundos
local CHASE_HOLD = 0.3         -- segundos parado na bola antes de voltar
local CHASE_COOLDOWN = 1.5     -- segundos antes de ir de novo na bola
local CHASE_MAX_BALL_HEIGHT = 6 -- altura máxima da bola (studs acima do chão da área) pra ainda ir atrás dela
local RED_ZONE_TRANSPARENCY = 0.85 -- transparência da área vermelha (0 = sólida, 1 = invisível)

local redZone = Instance.new("Part")
redZone.Name = "RedZone"
redZone.Anchored = true
redZone.CanCollide = false
redZone.CanTouch = false
redZone.CanQuery = false
redZone.CastShadow = false
redZone.Material = Enum.Material.Neon
redZone.Color = Color3.fromRGB(255, 0, 0)
redZone.Transparency = RED_ZONE_TRANSPARENCY -- vermelha no chão, bem transparente
redZone.Size = Vector3.new(RED_ZONE_LENGTH_X, 0.2, RED_ZONE_SIZE_Z)
redZone.CFrame = CFrame.new(RED_ZONE_POS)

local function isInsideRedZone(pos, margin)
    margin = margin or 0
    return math.abs(pos.X - RED_ZONE_POS.X) <= RED_ZONE_LENGTH_X / 2 + margin
        and math.abs(pos.Z - RED_ZONE_POS.Z) <= RED_ZONE_SIZE_Z / 2 + margin
        and pos.Y >= RED_ZONE_POS.Y - 6
        and pos.Y <= RED_ZONE_POS.Y + 20
end

-- Detecta pelo PÉ do personagem (sola) e também pelas pernas/corpo, funciona em R6 e R15
local FOOT_PARTS = { "LeftFoot", "RightFoot", "Left Leg", "Right Leg", "LeftLowerLeg", "RightLowerLeg" }

local function isCharInRedZone(char, margin)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or (char:IsA("Model") and char.PrimaryPart)
    if not hrp then return false end

    -- sola estimada pelo HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hip = hum and hum.HipHeight or 0
    if isInsideRedZone(hrp.Position - Vector3.new(0, hip + hrp.Size.Y / 2, 0), margin) then return true end
    if isInsideRedZone(hrp.Position, margin) then return true end

    -- sola de cada pé/perna (parte de baixo da peça)
    for _, name in ipairs(FOOT_PARTS) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            if isInsideRedZone(part.Position - Vector3.new(0, part.Size.Y / 2, 0), margin) then return true end
            if isInsideRedZone(part.Position, margin) then return true end
        end
    end
    return false
end

-- NUNCA SAIR DA ÁREA VERMELHA (parte do Auto Dive Farm)
-- Depois que o personagem está dentro da área, ele é mantido dentro dela o tempo todo:
-- andando, perseguindo a bola e também durante o mergulho (Q/E) do Auto Dive.
local RED_ZONE_KEEP_MARGIN = 0.5 -- folga pra dentro da borda (studs)
local insideZoneOnce = false     -- só começa a prender depois que você já entrou na área

localPlayer.CharacterAdded:Connect(function()
    insideZoneOnce = false
end)

RunService.Heartbeat:Connect(function()
    if not autoDive then
        insideZoneOnce = false
        return
    end

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local pos = hrp.Position
    local minX = RED_ZONE_POS.X - RED_ZONE_LENGTH_X / 2 + RED_ZONE_KEEP_MARGIN
    local maxX = RED_ZONE_POS.X + RED_ZONE_LENGTH_X / 2 - RED_ZONE_KEEP_MARGIN
    local minZ = RED_ZONE_POS.Z - RED_ZONE_SIZE_Z / 2 + RED_ZONE_KEEP_MARGIN
    local maxZ = RED_ZONE_POS.Z + RED_ZONE_SIZE_Z / 2 - RED_ZONE_KEEP_MARGIN

    if not insideZoneOnce then
        if pos.X >= minX and pos.X <= maxX and pos.Z >= minZ and pos.Z <= maxZ then
            insideZoneOnce = true
        end
        return
    end

    local cx = math.clamp(pos.X, minX, maxX)
    local cz = math.clamp(pos.Z, minZ, maxZ)

    if cx ~= pos.X or cz ~= pos.Z then
        local rotation = hrp.CFrame - hrp.CFrame.Position
        hrp.CFrame = CFrame.new(cx, pos.Y, cz) * rotation

        -- zera só a velocidade que empurrava pra fora
        local vel = hrp.AssemblyLinearVelocity
        hrp.AssemblyLinearVelocity = Vector3.new(
            (cx ~= pos.X) and 0 or vel.X,
            vel.Y,
            (cz ~= pos.Z) and 0 or vel.Z
        )
    end
end)

-- Bola alta/no ar: o tween não vai atrás
local function ballTooHigh(ball)
    return (ball.Position.Y - RED_ZONE_POS.Y) > CHASE_MAX_BALL_HEIGHT
end

local lastBallChase = 0

-- TWEEN NA BOLA: quando a bola (a mesma que o Auto Dive enxerga) entra na área vermelha,
-- o personagem desliza rápido até ela (mantendo a sua altura) e, depois de alcançar,
-- volta pro lugar salvo. Se o Auto Dive pular (Q/E) no meio, para na hora pra não atrapalhar.
local function chaseBall()
    chasingPlayer = true
    stopWalkTween()

    local startT = os.clock()
    local caught = false
    while autoDive and os.clock() - startT < CHASE_TIMEOUT do
        local dt = RunService.Heartbeat:Wait()
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local ball = D()
        if not (hum and hrp and ball) or hum.Health <= 0 then break end

        -- Mergulho (Q/E) começou: deixa o Auto Dive rodar livre
        if lastDiveClock >= startT then break end

        -- Bola subiu (alta/no ar): desiste
        if ballTooHigh(ball) then break end

        -- Bola saiu da área (e já passou o tempo de tolerância): para e volta pro gol
        if not isInsideRedZone(ball.Position) and os.clock() - startT > CHASE_EXIT_GRACE then break end

        -- Não se afasta demais do lugar salvo
        if (hrp.Position - WALK_POS).Magnitude > CHASE_MAX_FROM_POST then break end

        -- Mira um pouco à frente da bola e desliza reto até ela
        local bv = ball.AssemblyLinearVelocity or ball.Velocity
        local goal = ball.Position + bv * CHASE_LEAD
        goal = Vector3.new(goal.X, hrp.Position.Y, goal.Z)
        local offset = goal - hrp.Position
        local dist = offset.Magnitude

        if dist <= CHASE_STOP_DIST then
            caught = true -- chegou na bola
            break
        end

        local step = math.min(CHASE_TWEEN_SPEED * dt, dist - CHASE_STOP_DIST)
        local rotation = hrp.CFrame - hrp.CFrame.Position
        hrp.CFrame = CFrame.new(hrp.Position + offset.Unit * step) * rotation
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    -- Para de andar (cancela qualquer MoveTo)
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        hum:MoveTo(hrp.Position)
    end

    if caught then
        task.wait(CHASE_HOLD)
    end
    lastBallChase = os.clock()
    chasingPlayer = false

    -- Depois de ir na bola, volta pra coordenada salva
    if autoDive then
        walkToPoint = true
    end
end

local ballPrevPos, ballPrevT = nil, 0
local ballWasInside, ballPending = false, false

task.spawn(function()
    while true do
        if not autoDive then
            redZone.Parent = nil
            task.wait(0.2)
        else
            if redZone.Parent ~= Workspace then
                redZone.Parent = Workspace
            end

            -- O tween funciona com o SEU personagem perto da área vermelha (até RED_ZONE_SELF_MARGIN studs)
            local myChar = localPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local meInside = myHrp and isCharInRedZone(myChar, RED_ZONE_SELF_MARGIN)

            -- Acompanha a bola TODO frame (mesmo durante a perseguição ou o mergulho)
            local ball = D()
            local ballInside, ballMoving = false, false
            if ball and ball.Parent then
                local pos = ball.Position
                local nowT = os.clock()

                -- Velocidade REAL pela posição: funciona mesmo com a bola nos pés de alguém,
                -- quando a velocidade informada pelo jogo vem zerada
                local posSpeed = 0
                if ballPrevPos and nowT > ballPrevT then
                    local d = pos - ballPrevPos
                    posSpeed = Vector3.new(d.X, 0, d.Z).Magnitude / (nowT - ballPrevT)
                end
                ballPrevPos, ballPrevT = pos, nowT

                local bv = ball.AssemblyLinearVelocity or ball.Velocity
                local repSpeed = Vector3.new(bv.X, 0, bv.Z).Magnitude
                ballMoving = math.max(posSpeed, repSpeed) > 2.5
                ballInside = isInsideRedZone(pos)
            else
                ballPrevPos = nil
            end

            -- Bola acabou de entrar na área: fica "pendente" até o tween poder ir
            if ballInside and not ballWasInside then ballPending = true end
            if not ballInside then ballPending = false end
            ballWasInside = ballInside

            if not chasingPlayer and meInside and os.clock() - lastDiveClock >= DIVE_FREE_TIME
                and ballInside and not (ball and ballTooHigh(ball)) and (ballPending or ballMoving)
                and os.clock() - lastBallChase > CHASE_COOLDOWN then
                ballPending = false
                -- pcall: se der qualquer erro na perseguição, o tween não fica travado
                local ok = pcall(chaseBall)
                if not ok then
                    chasingPlayer = false
                    if autoDive then walkToPoint = true end
                end
            end
            RunService.Heartbeat:Wait() -- checa a cada frame: reação instantânea
        end
    end
end)

-- ANTI-KICK AFK (parte do Auto Dive Farm)
-- A cada 15 segundos o personagem dá um passo curto de verdade (tecla A ou D) e
-- volta pro mesmo lugar, então fica praticamente parado mas conta como atividade.
-- Não faz nada enquanto está indo pro gol ou atrás de alguém na área vermelha.
local AFK_MOVE_INTERVAL = 15   -- segundos entre cada passo
local AFK_MOVE_TIME = 0.15     -- tempo andando (curto)
local afkSide = 1

task.spawn(function()
    while true do
        task.wait(AFK_MOVE_INTERVAL)

        local walkingTween = walkTween and walkTween.PlaybackState == Enum.PlaybackState.Playing
        if autoDive and not chasingPlayer and not walkToPoint and not walkingTween
            and os.clock() - lastDiveClock > 2 then
            local char = localPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if hum and hrp and hum.Health > 0 and hum.FloorMaterial ~= Enum.Material.Air then
                local savedPos = hrp.Position
                afkSide = -afkSide
                local key = afkSide > 0 and Enum.KeyCode.D or Enum.KeyCode.A

                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(AFK_MOVE_TIME)
                VirtualInputManager:SendKeyEvent(false, key, false, game)

                -- Volta pro mesmo lugar (se nenhum tween assumiu o controle nesse meio tempo)
                local tweenNow = walkTween and walkTween.PlaybackState == Enum.PlaybackState.Playing
                if autoDive and not chasingPlayer and not walkToPoint and not tweenNow
                    and os.clock() - lastDiveClock > 2 and hrp.Parent then
                    local rotation = hrp.CFrame - hrp.CFrame.Position
                    hrp.CFrame = CFrame.new(savedPos) * rotation
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    end
end)
