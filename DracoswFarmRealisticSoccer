local function D()
    if x and x:IsDescendantOf(Workspace) then return x end
    local E = Workspace:FindFirstChild("TPS") or Workspace:FindFirstChild("Ball") or Workspace:FindFirstChild("Football")
    if E then 
        if E:IsA("BasePart") then x = E return E 
        elseif E:IsA("Model") and E.PrimaryPart then x = E.PrimaryPart return E.PrimaryPart end 
    end
    for _, F in ipairs(Workspace:GetChildren()) do 
        local G = F.Name:lower()
        if G:find("ball") or G:find("tps") or G:find("bola") then 
            if F:IsA("BasePart") and F.CanCollide then x = F return F 
            elseif F:IsA("Model") and F.PrimaryPart then x = F.PrimaryPart return F.PrimaryPart end 
        end 
    end
    x = nil return nil
end

local function H(I)
